# ProjectHub API — copy this file to server/.env and fill in real values.
# Never commit server/.env; it is ignored by Git.

# Port the API listens on (hosts usually inject PORT themselves).
PORT=5000

# Comma-separated browser origins allowed to call this API.
# Add your local dev origin only if it differs from the defaults below.
ALLOWED_ORIGINS=https://project-huubb.vercel.app,http://localhost:5500,http://127.0.0.1:5500

# SMTP account used to SEND the enquiry email.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Envelope sender (must be an address the SMTP account is allowed to send as).
MAIL_FROM=ProjectHub <your-sender-address@gmail.com>

# Where enquiries are delivered.
MAIL_TO=your-enquiry-inbox@example.com

# Optional tuning.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
TRUST_PROXY_HOPS=1
